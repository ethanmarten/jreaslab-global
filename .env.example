# Server-only. Configure these in the new Vercel project's environment settings.
# Never prefix mail credentials with VITE_ or commit a populated .env file.
RESEND_API_KEY=
# A sender address on a domain verified in your Resend account.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@jreaslab.com
# Exact production origin, without a path. Optional: defaults to request host.
SITE_URL=

# Public canonical URL used at build time; never put secrets in VITE_ variables.
VITE_SITE_URL=https://jreaslab-global.vercel.app
